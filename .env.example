# Azure OpenAI chat deployments
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_API_VERSION=2024-12-01-preview

# Optional alternate Azure route, used automatically for o3-mini when set
AZURE_ENDPOINT_2=
AZURE_API_KEY_2=
AZURE_API_VERSION_2=2024-12-01-preview

# Azure/OpenAI web-search deployment for CLEAR dynamic evidence
AZURE_WEBSEARCH_DEPLOYMENT=gpt-4o
AZURE_WEBSEARCH_API_VERSION=2025-03-01-preview

# OpenAI API fallback
OPENAI_API_KEY=

# Qwen OpenAI-compatible local server
QWEN_OPENAI_BASE_URL=http://localhost:8000/v1
QWEN_OPENAI_API_KEY=EMPTY
QWEN_MODEL=Qwen/Qwen3.5-9B
QWEN_MAX_TOKENS=1024

# Local retrieval corpus root for BM25/MedCPT
MEDRAG_CORPORA_DIR=corpora
